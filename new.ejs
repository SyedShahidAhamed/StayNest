<%-layout("/layouts/boilerplate") %>
<body>
    <div class="row">
        <div class="col-8 offset-2">
            <form method="post" action="/listing" class="needs-validation" novalidate enctype="multipart/form-data">
                <h3>Create A New Listing</h3>
                <div class="mb-3">
                    <label for="form" class="form-label">Title</label>
                    <input type="text" placeholder="Enter Your Listing Title" name="title" class="form-control" required>
                  <div class="valid-feedback">Looks good!</div>   
                  <div id="validationServerUsernameFeedback" class="invalid-feedback">Enter a valid Title.</div>
                </div>
                
                <div class="mb-3">
                    <label for="form" class="form-label">Description</label>
                    <textarea name="description" class="form-control"></textarea>
                  <div class="valid-feedback">Looks good!</div> 
                  <div id="validationServerUsernameFeedback" class="invalid-feedback">Enter a valid Description.</div>   
                </div>
                <div class="mb-3">
                    <label for="image" class="form-label">Upload Image</label>
                    <input type="file" placeholder="Enter Your Listing Img_Url" name="image" class="form-control">
                  <div id="validationServerUsernameFeedback" class="invalid-feedback">Enter a valid Image.</div>  
                </div>
                <div class="row">
                    <div class="mb-3 col-4">
                    <label for="form" class="form-label">Price</label>
                    <input type="text" placeholder="Enter Your Listing Price" name="price" class="form-control" required>
                   <div id="validationServerUsernameFeedback" class="invalid-feedback">Enter a valid Price.</div>  
                </div>
                <div class="mb-3 col-8">
                    <label for="form"class="form-label">Location</label>
                    <input type="text" placeholder="Enter Your Listing Location" name="location" class="form-control" required>
                  <div id="validationServerUsernameFeedback" class="invalid-feedback">Enter a valid Location.</div>  
                </div>
                </div>
                <div class="mb-3">
                    <label for="form" class="form-label">Country</label>
                    <input type="text" placeholder="Enter Your Listing Country" name="country" class="form-control" required>
                  <div id="validationServerUsernameFeedback" class="invalid-feedback">Enter a valid Country.</div>   
                </div>
                <button>Submit</button>
            </form>
        </div>
    </div>
</body>
