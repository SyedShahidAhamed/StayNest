<% layout("/layouts/boilerplate") -%>
<body>
    <div class="row">
        <div class="col-8 offset-3 mt-3">
            <h3>Listing Details: </h3>
        </div>
        <div class="card col-6 offset-3 show-card">
            <img src="<%=data.image.url %>" class="card-img-top show-img" alt="...">
            <div class="card-body">
                <p class="card-text">
                    owned by: <b><%=data.owner.username %></b>
                </p>
                <p class="card-text">
                    <B><%= data.title %></B>
                </p>
                <p class="card-text">
                    <%= data.description %>
                </p>
                <p class="card-text">
                    ₹<%= data.price%>
                </p>
                <p class="card-text">
                    <%= data.location %>
                </p>
                <p class="card-text">
                    <%= data.country %>
                </p>
            </div>
        </div>
        <% if(curUser&&curUser._id.equals(data.owner._id)){ %>
            <div class="btns">
                <div class="col-1 offset-3">
                    <form action="/listing/<%=data._id %>/edit" method="get">
                        <button class="btn btn-danger ps-4 pe-4 ">Edit</button>
                    </form>
                </div>
                <!-- <a href="/listing/<%=data._id %>/edit" class="btn btn-danger col-1 offset-3 ">Edit</a><br><br> -->
                <form action="/listing/<%=data._id %>?_method=DELETE" method="post">
                    <button class="btn btn-dark ">Delete</button>
                </form>
            </div>
        <% } %>



        <!-- Review System -->
        <div class="col-6 offset-3">
            <hr>
            <% if(curUser){ %>
                <h3>Leave a Review</h3>
                <form action="/listing/<%=data._id %>/reviews" method="post" class="needs-validation" novalidate> 
                    <label for="range2" class="form-label">Rating</label>
                    <fieldset class="starability-slot">
                        <input type="radio" id="no-rate" class="input-no-rate" name="rating" value="0" checked aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="rating" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="rating" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="rating" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="rating" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="rating" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                    <div class="mb-3">
                        <label for="exampleFormControlTextarea1" class="form-label">Comments</label>
                        <textarea class="form-control" id="exampleFormControlTextarea1" rows="5" name="comments" required></textarea>
                        <div id="validationServerUsernameFeedback" class="invalid-feedback">Enter a valid Comment</div> 
                    </div>
                    <button type="submit" class="btn btn-outline-dark">Submit</button>
                    <hr>
                </form>
            <% } %>
        </div>
        <div class="col-6 offset-3">
            <div class="row">
                <% for(review of data.review){ %>
                    <div class="card col-5 ms-3 mb-3 ">
                        <div class="card-body one p-3">
                            <p class="starability-result" data-rating="<%= review.rating %>"></p>
                            <h5 class="card-title">@<%= review.author.username%></h5>
                            <p class="card-text"><%= review.comments %></p>  
                            <form action="/listing/<%=data._id %>/reviews/<%=review._id %>?_method=DELETE" method="post">
                                <button class="btn btn-dark">Delete</button>
                            </form>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</body>
</html>