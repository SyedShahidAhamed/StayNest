<%-layout("/layouts/boilerplate") %>
<%=success %>
<body>
    <h2 class="mt-3">All listing</h2>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
        <%for (dat of data){%>
            <a href="/listing/<%=dat._id%>">
                <div class="card col ">
                    <img src="<%=dat.image.url %>" class="card-img-top" alt="..." style="height: 20rem">
                    <div class="card-body">
                        <p class="card-text">
                            <b><%= dat.title %></b><br>
                            ₹<%= dat.price %>/ night
                        </p>
                    </div>
                </div> 
            </a> 
        <% } %>
    </div>
</body>

